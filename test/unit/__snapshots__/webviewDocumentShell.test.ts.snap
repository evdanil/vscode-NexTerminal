    <button type="button" class="btn-secondary" id="open-macros-btn">Macros…</button>
  </div>
  <h3 id="section-ui">Interface</h3>
  <div class="form-group form-group-checkbox">
  <label for="setting-nexus-ui-showTreeDescriptions">
    <input type="checkbox" id="setting-nexus-ui-showTreeDescriptions" data-section="nexus.ui" data-key="showTreeDescriptions" checked />
